{
  "name": "cdp-browser-mcp",
  "version": "1.0.0",
  "description": "MCP server that attaches to existing Chromium browsers over CDP. Multi-session control for Chrome, Edge, AdsPower, BitBrowser, and any remote-debugging endpoint.",
  "type": "module",
  "main": "index.mjs",
  "bin": {
    "cdp-browser-mcp": "index.mjs"
  },
  "files": [
    "index.mjs",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "start": "node index.mjs"
  },
  "mcpName": "io.github.killaragorn/cdp-browser-mcp",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude",
    "claude-desktop",
    "claude-code",
    "cdp",
    "chrome-devtools-protocol",
    "browser",
    "playwright",
    "patchright",
    "adspower",
    "bitbrowser",
    "connectOverCDP"
  ],
  "author": "killaragorn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/killaragorn/cdp-browser-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/killaragorn/cdp-browser-mcp/issues"
  },
  "homepage": "https://github.com/killaragorn/cdp-browser-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "patchright": "^1.52.0"
  }
}
